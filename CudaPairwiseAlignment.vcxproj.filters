<?xml version="1.0" encoding="utf-8"?>
<!-- ==========================================================================
     CudaPairwiseAlignment.vcxproj.filters
     =========================================================================
     PURELY COSMETIC. This file does not affect the build at all; it only tells
     the Visual Studio Solution Explorer how to GROUP the files into virtual
     folders ("filters") in the IDE tree. Deleting it would change nothing
     except that all files would appear in one flat list. We include it so the
     project looks tidy when you open it.
     ====================================================================== -->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Filter Include="Source Files (host .cpp)">
      <UniqueIdentifier>{11111111-1111-1111-1111-111111111111}</UniqueIdentifier>
    </Filter>
    <Filter Include="Source Files (CUDA .cu)">
      <UniqueIdentifier>{22222222-2222-2222-2222-222222222222}</UniqueIdentifier>
    </Filter>
    <Filter Include="Header Files">
      <UniqueIdentifier>{33333333-3333-3333-3333-333333333333}</UniqueIdentifier>
    </Filter>
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="src\alignment_common.cpp">
      <Filter>Source Files (host .cpp)</Filter>
    </ClCompile>
    <ClCompile Include="src\cpu_reference.cpp">
      <Filter>Source Files (host .cpp)</Filter>
    </ClCompile>
    <ClCompile Include="demo\demo_main.cpp">
      <Filter>Source Files (host .cpp)</Filter>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <CudaCompile Include="src\gpu_wavefront.cu">
      <Filter>Source Files (CUDA .cu)</Filter>
    </CudaCompile>
    <CudaCompile Include="src\gpu_batched.cu">
      <Filter>Source Files (CUDA .cu)</Filter>
    </CudaCompile>
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="include\alignment_common.h">
      <Filter>Header Files</Filter>
    </ClInclude>
    <ClInclude Include="include\cpu_reference.h">
      <Filter>Header Files</Filter>
    </ClInclude>
    <ClInclude Include="include\cuda_utils.cuh">
      <Filter>Header Files</Filter>
    </ClInclude>
    <ClInclude Include="include\gpu_wavefront.cuh">
      <Filter>Header Files</Filter>
    </ClInclude>
    <ClInclude Include="include\gpu_batched.cuh">
      <Filter>Header Files</Filter>
    </ClInclude>
  </ItemGroup>
</Project>
